# Generate each value independently with: openssl rand -hex 32
CONTROL_API_KEY=replace-with-a-new-client-facing-key
HERMES_API_KEY=copy-from-the-voice-profile-env
HERMES_URL=http://127.0.0.1:8642/p/voice/v1/responses
HERMES_MODEL=voice
# Increment this to start a fresh Hermes runtime session without losing PWA history.
HERMES_SESSION_GENERATION=1
REQUEST_TIMEOUT_SECONDS=120
HISTORY_DB_PATH=/var/lib/hermes-control/history.db
TASK_CACHE_TTL_SECONDS=300
# Shown once when creating OpenTodo's webhook delivery channel.
OPENTODO_WEBHOOK_SECRET=whsec_replace-with-the-opentodo-channel-secret
HEX_BIN=hex
FFMPEG_BIN=ffmpeg
VOICE_TEMP_DIR=/var/lib/hermes-control/voice
VOICE_MAX_BYTES=52428800
ATTACHMENT_DIR=/var/lib/hermes-control/attachments
ATTACHMENT_MAX_BYTES=10485760
TTS_CACHE_DIR=/var/lib/hermes-control/tts-cache
